diff --git a/drivers/misc/ntsync.c b/drivers/misc/ntsync.c
index 528dda6f9..028ace44f 100644
--- a/drivers/misc/ntsync.c
+++ b/drivers/misc/ntsync.c
@@ -14,7 +14,8 @@
 #include <linux/miscdevice.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/overflow.h>
+#include <linux/compat.h>
 #include <linux/sched.h>
 #include <linux/sched/signal.h>
 #include <linux/slab.h>
@@ -26,6 +26,34 @@
 #include <linux/path.h>
 #include <linux/xattr.h>
 #include <linux/version.h>
+#include <linux/uaccess.h>
+
+#ifndef atomic_try_cmpxchg
+static inline bool atomic_try_cmpxchg(atomic_t *value, int *old, int new)
+{
+	int old_value = atomic_cmpxchg(value, *old, new);
+
+	if (old_value == *old)
+		return true;
+	*old = old_value;
+	return false;
+}
+#endif
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 15, 0)
+#define lockdep_assert(condition) do { } while (0)
+#define lockdep_is_held(lock) 1
+#define LOCK_STATE_NOT_HELD 0
+#endif
+
+#ifndef compat_ptr_ioctl
+static long compat_ptr_ioctl(struct file *file, unsigned int cmd,
+								 unsigned long arg)
+{
+	return file->f_op->unlocked_ioctl(file, cmd,
+								  (unsigned long)compat_ptr(arg));
+}
+#endif
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 3, 0)
 #include <linux/mnt_idmapping.h>
