diff --git a/kernel/policy/allowlist.c b/kernel/policy/allowlist.c
--- a/kernel/policy/allowlist.c
+++ b/kernel/policy/allowlist.c
@@ -413,8 +413,25 @@
     loff_t off = 0;
     int i;
 
-    const struct cred *saved = override_creds(ksu_cred);
-    struct file *fp = filp_open(KERNEL_SU_ALLOWLIST, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    struct cred *io_cred;
+    const struct cred *saved;
+    struct file *fp;
+
+    /*
+     * This callback runs in init. Legacy fscrypt finds data keys through
+     * the caller's keyrings, which are populated after ksu_cred was captured
+     * at boot. Keep init's current keyrings while using the KernelSU domain.
+     * Never replace init's real credentials or alter the encryption policy.
+     */
+    io_cred = prepare_creds();
+    if (!io_cred) {
+        pr_err("save_allow_list prepare credentials failed\n");
+        kfree(_cb);
+        return;
+    }
+    setup_selinux(KERNEL_SU_CONTEXT, io_cred);
+    saved = override_creds(io_cred);
+    fp = filp_open(KERNEL_SU_ALLOWLIST, O_WRONLY | O_CREAT | O_TRUNC, 0644);
     if (IS_ERR(fp)) {
         pr_err("save_allow_list create file failed: %ld\n", PTR_ERR(fp));
         goto out;
@@ -444,6 +461,7 @@
     filp_close(fp, 0);
 out:
     revert_creds(saved);
+    put_cred(io_cred);
     kfree(_cb);
 }
 
