--- a/drivers/of/base.c
+++ b/drivers/of/base.c
@@ -45,6 +45,62 @@ static const char *of_stdout_options;
 
 struct kset *of_kset;
 
+static void __init of_par_fixup_fstab(void)
+{
+	struct device_node *fstab_np;
+	struct device_node *child;
+	struct property *prop;
+
+	fstab_np = of_find_node_by_path("/firmware/android/fstab");
+	if (!fstab_np)
+		return;
+
+	for_each_child_of_node(fstab_np, child) {
+		/*
+		 * In EMUI 9.1, Huawei added preavs to the DT fstab.
+		 * It mounts to /vendor/preavs before /vendor is mounted,
+		 * uses incompatible AVB metadata, and is not needed for AOSP/GSI.
+		 * Disable it so Android first-stage init skips it completely.
+		 */
+		if (strcmp(child->name, "preavs") == 0 || strstr(child->name, "preavs")) {
+			prop = of_find_property(child, "status", NULL);
+			if (prop) {
+				prop->value = "disabled";
+				prop->length = sizeof("disabled");
+				pr_info("disabled unneeded EMUI 9.1 preavs partition in DT fstab\n");
+			}
+			prop = of_find_property(child, "dev", NULL);
+			if (prop) {
+				prop->value = "";
+				prop->length = 1;
+			}
+			prop = of_find_property(child, "fsmgr_flags", NULL);
+			if (prop) {
+				prop->value = "wait,nofail";
+				prop->length = sizeof("wait,nofail");
+			}
+			continue;
+		}
+
+		/*
+		 * The stock boot loader validates Huawei's private vbmeta format,
+		 * but modern AOSP libavb rejects that metadata when a custom kernel
+		 * changes verifiedbootstate from green to orange.  The device is
+		 * unlocked, so mount the immutable vendor/odm partitions directly
+		 * instead of attempting a second, incompatible first-stage check.
+		 */
+		prop = of_find_property(child, "fsmgr_flags", NULL);
+		if (prop && prop->value && strstr(prop->value, "avb")) {
+			prop->value = "wait";
+			prop->length = sizeof("wait");
+			pr_info("disabled first-stage AVB flag for DT fstab partition %s\n",
+				child->name ? child->name : "<unknown>");
+		}
+	}
+
+	of_node_put(fstab_np);
+}
+
 /*
  * Used to protect the of_aliases, to hold off addition of nodes to sysfs.
  * This mutex must be held whenever modifications are being made to the
@@ -218,6 +274,8 @@ void __init of_core_init(void)
 	/* Symlink in /proc as required by userspace ABI */
 	if (of_root)
 		proc_symlink("device-tree", NULL, "/sys/firmware/devicetree/base");
+
+	of_par_fixup_fstab();
 }
 
