diff --git a/drivers/of/Kconfig b/drivers/of/Kconfig
index 67352b538..a5f649a5a 100644
--- a/drivers/of/Kconfig
+++ b/drivers/of/Kconfig
@@ -117,3 +117,12 @@ config OF_NUMA
 	bool
 
 endif # OF
+
+config PAR_GSI_FSTAB
+	bool "Huawei PAR GSI device-tree fstab compatibility"
+	depends on OF
+	default n
+	help
+	  Disable the unused preavs entry and remove only avb/avb= flags
+	  from the bootloader-provided fstab for unlocked PAR GSI builds.
+	  Other mount flags are retained. Leave disabled for stock builds.
diff --git a/drivers/of/base.c b/drivers/of/base.c
index a4a2960d5..dfdc65571 100644
--- a/drivers/of/base.c
+++ b/drivers/of/base.c
@@ -199,10 +199,93 @@ int __of_attach_node_sysfs(struct device_node *np)
 	return 0;
 }
 
+#ifdef CONFIG_PAR_GSI_FSTAB
+/* PAR's unlocked GSI boot uses Huawei's DT fstab but not its AVB metadata. */
+static int __init of_par_set_string(struct device_node *np,
+		const char *name, const char *value)
+{
+	struct property *prop = kzalloc(sizeof(*prop), GFP_KERNEL);
+	int ret;
+
+	if (!prop)
+		return -ENOMEM;
+	prop->name = kstrdup(name, GFP_KERNEL);
+	prop->value = kstrdup(value, GFP_KERNEL);
+	prop->length = strlen(value) + 1;
+	if (!prop->name || !prop->value) {
+		ret = -ENOMEM;
+		goto free_prop;
+	}
+	ret = of_update_property(np, prop);
+	if (!ret)
+		return 0;
+free_prop:
+	kfree(prop->name);
+	kfree(prop->value);
+	kfree(prop);
+	return ret;
+}
+
+static void __init of_par_fixup_fstab(void)
+{
+	struct device_node *fstab, *child;
+
+	fstab = of_find_node_by_path("/firmware/android/fstab");
+	if (!fstab)
+		return;
+	for_each_child_of_node(fstab, child) {
+		const char *flags;
+		char *copy, *next, *token, *filtered, *end;
+		int ret = 0;
+
+		if (!strcmp(child->name, "preavs")) {
+			ret = of_par_set_string(child, "status", "disabled");
+			if (ret)
+				pr_err("PAR: cannot disable preavs: %d\n", ret);
+			continue;
+		}
+		if (of_property_read_string(child, "fsmgr_flags", &flags))
+			continue;
+		copy = kstrdup(flags, GFP_KERNEL);
+		filtered = kzalloc(strlen(flags) + 1, GFP_KERNEL);
+		if (!copy || !filtered) {
+			kfree(copy);
+			kfree(filtered);
+			pr_err("PAR: cannot allocate fstab flags\n");
+			continue;
+		}
+		next = copy;
+		end = filtered;
+		while ((token = strsep(&next, ","))) {
+			if (!strcmp(token, "avb") || !strncmp(token, "avb=", 4))
+				continue;
+			if (!*token)
+				continue;
+			if (end != filtered)
+				*end++ = ',';
+			memcpy(end, token, strlen(token));
+			end += strlen(token);
+		}
+		if (strcmp(flags, filtered))
+			ret = of_par_set_string(child, "fsmgr_flags", filtered);
+		if (ret)
+			pr_err("PAR: cannot update %s fstab flags: %d\n", child->name, ret);
+		kfree(copy);
+		kfree(filtered);
+	}
+	of_node_put(fstab);
+}
+#endif
+
 void __init of_core_init(void)
 {
 	struct device_node *np;
 
+	/* Keep sysfs property lengths consistent with the updated tree. */
+#ifdef CONFIG_PAR_GSI_FSTAB
+	of_par_fixup_fstab();
+#endif
+
 	/* Create the kset, and register existing nodes */
 	mutex_lock(&of_mutex);
 	of_kset = kset_create_and_add("devicetree", NULL, firmware_kobj);
